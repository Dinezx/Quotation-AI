# Supabase Credentials & Asymmetric JWKS Verification
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# PostgreSQL Database Connection Strings
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Application Settings
PROJECT_NAME="Quotation AI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI / OCR Extraction Configuration
PO_EXTRACTION_PROVIDER=mock  # Options: mock, azure
GEMINI_API_KEY=your-gemini-api-key-if-configured
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-document-intelligence-key

